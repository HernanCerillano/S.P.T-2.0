{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "S.P.T. Suspension Tito",
  "version": "0.1.0",
  "identifier": "com.spt.taller",
  "build": {
    "frontendDist": "../dist/spt-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run prepare:bundle"
  },
  "app": {
    "windows": [
      {
        "title": "S.P.T. — Suspension Tito",
        "width": 1366,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/SPT-backend.jar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
